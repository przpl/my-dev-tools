{
    "name": "my-dev-tools",
    "displayName": "My Dev Tools",
    "description": "A simple extension to serve MY programming needs. It contains a number of small features that I need in MY work hence the prefix 'My'. Nevertheless, you may find something here that will also be useful to you.",
    "icon": "images/icon.png",
    "version": "1.14.0",
    "publisher": "przpl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/przpl/my-dev-tools"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other",
        "Snippets",
        "Formatters"
    ],
    "keywords": [
        "dev",
        "tools",
        "helper",
        "react",
        "props",
        "typescript",
        "nestjs"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "enabledApiProposals": [
        "contribSourceControlInputBoxMenu"
    ],
    "contributes": {
        "languages": [
            {
                "id": "myDevToolsCommit",
                "aliases": [
                    "My Dev Tools Commit Message"
                ],
                "filenames": [
                    "MY_DEV_TOOLS_COMMIT_EDITMSG"
                ],
                "configuration": "./language-configuration/my-dev-tools-commit.json"
            }
        ],
        "grammars": [
            {
                "language": "myDevToolsCommit",
                "scopeName": "text.my-dev-tools-commit",
                "path": "./syntaxes/my-dev-tools-commit.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "[myDevToolsCommit]": {
                "editor.rulers": [
                    50,
                    72
                ]
            }
        },
        "configuration": {
            "title": "My Dev Tools",
            "properties": {
                "myDevTools.enableRealTimePropsUpdate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable real-time updates for React Props destructuring"
                },
                "myDevTools.autoRenameStrategy": {
                    "type": "string",
                    "default": "kebab-case",
                    "enum": [
                        "camelCase",
                        "PascalCase",
                        "snake_case",
                        "kebab-case"
                    ],
                    "enumDescriptions": [
                        "Convert to camelCase",
                        "Convert to PascalCase",
                        "Convert to snake_case",
                        "Convert to kebab-case"
                    ],
                    "description": "Naming strategy to use when auto-renaming files based on exported symbols"
                },
                "myDevTools.openRouter.model": {
                    "type": "string",
                    "default": "openai/gpt-5.6-luna",
                    "description": "OpenRouter model used to generate commit messages"
                },
                "myDevTools.openRouter.baseUrl": {
                    "type": "string",
                    "default": "https://openrouter.ai/api/v1",
                    "description": "OpenRouter API base URL"
                },
                "myDevTools.commitMessage.maxDiffCharacters": {
                    "type": "number",
                    "default": 80000,
                    "minimum": 2000,
                    "description": "Character budget for the diff sent to the model. Above it, context lines are dropped and then each file is truncated to a share of the budget"
                },
                "myDevTools.commitMessage.stripImportsAboveLines": {
                    "type": "number",
                    "default": 200,
                    "minimum": 0,
                    "description": "Once the compacted diff exceeds this many lines, hunks containing nothing but import and re-export changes are dropped"
                },
                "myDevTools.commitMessage.summarizeAddedScriptsAboveLines": {
                    "type": "number",
                    "default": 60,
                    "minimum": 0,
                    "description": "A newly added TypeScript or JavaScript file longer than this is reduced to its declarations: imports, types, signatures, constants and comments are kept, function bodies become a line count. Set to 0 to always send new files in full"
                },
                "myDevTools.commitMessage.outlineAddedMarkdownAboveLines": {
                    "type": "number",
                    "default": 150,
                    "minimum": 0,
                    "description": "A newly added Markdown file longer than this is reduced to its headings. Raise it, or set it to 0, in a repository where documents are the product rather than supporting material"
                },
                "myDevTools.commitMessage.maxDiffLineLength": {
                    "type": "number",
                    "default": 160,
                    "minimum": 0,
                    "description": "Each diff line is truncated to this many characters, so one minified or embedded line costs a fixed price. Set to 0 to send every line in full"
                },
                "myDevTools.commitMessage.excludeGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/package-lock.json",
                        "**/npm-shrinkwrap.json",
                        "**/pnpm-lock.yaml",
                        "**/yarn.lock",
                        "**/bun.lockb",
                        "**/bun.lock",
                        "**/*.lock",
                        "**/go.sum",
                        "**/*.min.js",
                        "**/*.min.css",
                        "**/*.map",
                        "**/*.svg",
                        "**/__snapshots__/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/vendor/**"
                    ],
                    "description": "Files excluded from the diff sent to the model. They are still listed by name, so a dependency bump remains recognisable"
                },
                "myDevTools.commitMessage.additionalInstructions": {
                    "type": "string",
                    "default": "",
                    "editPresentation": "multilineText",
                    "description": "Extra instructions appended to the commit message prompt, for project-specific conventions"
                },
                "myDevTools.ai.commands": {
                    "type": "array",
                    "default": [],
                    "description": "AI commands available everywhere. Project-specific ones belong in the file named by 'myDevTools.ai.commandsFile', which is where completion and validation for the command format are offered; that file wins when both define the same id",
                    "items": {
                        "type": "object"
                    }
                },
                "myDevTools.ai.commandsFile": {
                    "type": "string",
                    "default": ".vscode/ai-commands.json",
                    "description": "Workspace-relative path to the JSON file holding this project's AI commands. Comments and trailing commas are allowed"
                },
                "myDevTools.ai.rulesDirectory": {
                    "type": "string",
                    "default": ".claude/rules",
                    "description": "Workspace-relative directory of Markdown rule files. Those whose frontmatter 'paths' match the edited file are attached to AI commands that did not opt out"
                },
                "myDevTools.ai.model": {
                    "type": "string",
                    "default": "",
                    "description": "Model used by AI commands that do not name one of their own. Empty falls back to 'myDevTools.openRouter.model'"
                },
                "myDevTools.ai.maxFileCharacters": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 1000,
                    "description": "An AI command refuses to run rather than send a file larger than this, so a minified or generated file cannot quietly cost a fortune"
                },
                "myDevTools.ai.requestTimeoutSeconds": {
                    "type": "number",
                    "default": 180,
                    "minimum": 10,
                    "description": "How long an AI command waits for the model. Whole-file rewrites and test generation need considerably longer than a commit message"
                }
            }
        },
        "commands": [
            {
                "command": "myDevTools.openNearestIndex",
                "title": "Go to nearest index.ts"
            },
            {
                "command": "myDevTools.addToExportsInIndex",
                "title": "Add to exports in index.ts"
            },
            {
                "command": "myDevTools.convertEolToLf",
                "title": "Convert EOL to LF"
            },
            {
                "command": "myDevTools.deleteEmptyDirectories",
                "title": "Delete empty directories"
            },
            {
                "command": "myDevTools.updatePropsDestructuring",
                "title": "Update React Props destructuring"
            },
            {
                "command": "myDevTools.toggleRealTimePropsUpdate",
                "title": "Toggle React Real-Time Props Update"
            },
            {
                "command": "myDevTools.addPropsToComponent",
                "title": "Add empty props to React component"
            },
            {
                "command": "myDevTools.addUndefinedPropsToInterface",
                "title": "Add undefined props to React component interface"
            },
            {
                "command": "myDevTools.addClassNameToProps",
                "title": "Add className to React Props"
            },
            {
                "command": "myDevTools.createNestJSController",
                "title": "Create controller"
            },
            {
                "command": "myDevTools.openNearestNestJSModule",
                "title": "Go to NestJS module"
            },
            {
                "command": "myDevTools.renameToCamelCase",
                "title": "Rename to camelCase"
            },
            {
                "command": "myDevTools.renameToPascalCase",
                "title": "Rename to PascalCase"
            },
            {
                "command": "myDevTools.renameToSnakeCase",
                "title": "Rename to snake_case"
            },
            {
                "command": "myDevTools.renameToKebabCase",
                "title": "Rename to kebab-case"
            },
            {
                "command": "myDevTools.autoRename",
                "title": "Auto rename file"
            },
            {
                "command": "myDevTools.quickCommit",
                "title": "Quick Commit..."
            },
            {
                "command": "myDevTools.commitToBranch",
                "title": "Commit to Branch..."
            },
            {
                "command": "myDevTools.autoStage",
                "title": "Auto Stage",
                "icon": "$(sparkle)"
            },
            {
                "command": "myDevTools.stageActiveFile",
                "title": "Stage Active File"
            },
            {
                "command": "myDevTools.generateCommitMessage",
                "title": "Generate Commit Message (My Dev Tools)",
                "icon": "$(sparkle)"
            },
            {
                "command": "myDevTools.acceptCommitMessage",
                "title": "Commit",
                "icon": "$(check)"
            },
            {
                "command": "myDevTools.generateCommitMessageInEditor",
                "title": "Generate Commit Message (My Dev Tools)",
                "icon": "$(sparkle)"
            },
            {
                "command": "myDevTools.setOpenRouterApiKey",
                "title": "Set OpenRouter API Key"
            },
            {
                "command": "myDevTools.setOpenRouterApiKey.shared",
                "title": "Set OpenRouter API Key: Shared"
            },
            {
                "command": "myDevTools.setOpenRouterApiKey.commitMessage",
                "title": "Set OpenRouter API Key: Commit Messages"
            },
            {
                "command": "myDevTools.setOpenRouterApiKey.aiCommands",
                "title": "Set OpenRouter API Key: AI Commands"
            },
            {
                "command": "myDevTools.clearOpenRouterApiKey",
                "title": "Clear OpenRouter API Key"
            },
            {
                "command": "myDevTools.runAiCommand",
                "title": "Run Command",
                "category": "AI",
                "icon": "$(sparkle)"
            },
            {
                "command": "myDevTools.editAiCommands",
                "title": "Edit Commands File",
                "category": "AI"
            },
            {
                "command": "myDevTools.syncAiCommandsToPalette",
                "title": "Sync Commands to Palette",
                "category": "AI"
            },
            {
                "command": "myDevTools.showExplorerFiles",
                "title": "Show Hidden Files in Explorer",
                "icon": "$(eye)"
            },
            {
                "command": "myDevTools.hideExplorerFiles",
                "title": "Hide Files in Explorer",
                "icon": "$(eye-closed)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "myDevTools.showExplorerFiles",
                    "when": "view == workbench.explorer.fileView && myDevTools.explorerPatternsExist && myDevTools.explorerFilesHidden",
                    "group": "navigation"
                },
                {
                    "command": "myDevTools.hideExplorerFiles",
                    "when": "view == workbench.explorer.fileView && myDevTools.explorerPatternsExist && !myDevTools.explorerFilesHidden",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "submenu": "NestJsToolsSubmenu",
                    "when": "explorerResourceIsFolder",
                    "group": "NestJsTools"
                },
                {
                    "submenu": "RenameToSubmenu",
                    "when": "!explorerResourceIsFolder && !explorerResourceReadonly",
                    "group": "2_rename"
                }
            ],
            "NestJsToolsSubmenu": [
                {
                    "command": "myDevTools.createNestJSController",
                    "when": "!explorerResourceReadonly",
                    "group": "NestJsTools"
                }
            ],
            "RenameToSubmenu": [
                {
                    "command": "myDevTools.renameToCamelCase",
                    "group": "rename"
                },
                {
                    "command": "myDevTools.renameToPascalCase",
                    "group": "rename"
                },
                {
                    "command": "myDevTools.renameToSnakeCase",
                    "group": "rename"
                },
                {
                    "command": "myDevTools.renameToKebabCase",
                    "group": "rename"
                },
                {
                    "command": "myDevTools.autoRename",
                    "group": "rename"
                }
            ],
            "editor/title": [
                {
                    "command": "myDevTools.generateCommitMessageInEditor",
                    "when": "resourceFilename == MY_DEV_TOOLS_COMMIT_EDITMSG",
                    "group": "navigation@1"
                },
                {
                    "command": "myDevTools.acceptCommitMessage",
                    "when": "resourceFilename == MY_DEV_TOOLS_COMMIT_EDITMSG",
                    "group": "navigation@2"
                }
            ],
            "scm/inputBox": [
                {
                    "command": "myDevTools.generateCommitMessage",
                    "when": "scmProvider == git"
                }
            ],
            "scm/title": [
                {
                    "command": "myDevTools.generateCommitMessage",
                    "when": "scmProvider == git",
                    "group": "navigation"
                }
            ],
            "scm/resourceState/context": [
                {
                    "command": "myDevTools.quickCommit",
                    "when": "scmProvider == git",
                    "group": "1_modification"
                },
                {
                    "command": "myDevTools.commitToBranch",
                    "when": "scmProvider == git",
                    "group": "1_modification"
                }
            ],
            "scm/resourceGroup/context": [
                {
                    "command": "myDevTools.autoStage",
                    "when": "scmProvider == git && scmResourceGroup == workingTree",
                    "group": "inline@3"
                },
                {
                    "command": "myDevTools.autoStage",
                    "when": "scmProvider == git && scmResourceGroup == workingTree",
                    "group": "1_modification"
                }
            ],
            "commandPalette": [
                {
                    "command": "myDevTools.quickCommit",
                    "when": "false"
                },
                {
                    "command": "myDevTools.commitToBranch",
                    "when": "false"
                },
                {
                    "command": "myDevTools.acceptCommitMessage",
                    "when": "resourceFilename == MY_DEV_TOOLS_COMMIT_EDITMSG"
                },
                {
                    "command": "myDevTools.generateCommitMessageInEditor",
                    "when": "resourceFilename == MY_DEV_TOOLS_COMMIT_EDITMSG"
                },
                {
                    "command": "myDevTools.updatePropsDestructuring",
                    "when": "editorLangId == typescriptreact"
                },
                {
                    "command": "myDevTools.toggleRealTimePropsUpdate"
                },
                {
                    "command": "myDevTools.addPropsToComponent",
                    "when": "editorLangId == typescriptreact"
                },
                {
                    "command": "myDevTools.addUndefinedPropsToInterface",
                    "when": "editorLangId == typescriptreact"
                },
                {
                    "command": "myDevTools.addClassNameToProps",
                    "when": "editorLangId == typescriptreact"
                },
                {
                    "command": "myDevTools.autoRename",
                    "when": "editorLangId == typescript || editorLangId == typescriptreact"
                }
            ]
        },
        "submenus": [
            {
                "label": "NestJS tools",
                "id": "NestJsToolsSubmenu",
                "items": [
                    {
                        "command": "myDevTools.createNestJSController",
                        "group": "NestJsTools"
                    }
                ]
            },
            {
                "label": "Rename to...",
                "id": "RenameToSubmenu",
                "items": [
                    {
                        "command": "myDevTools.renameToCamelCase",
                        "group": "rename"
                    },
                    {
                        "command": "myDevTools.renameToPascalCase",
                        "group": "rename"
                    },
                    {
                        "command": "myDevTools.renameToSnakeCase",
                        "group": "rename"
                    },
                    {
                        "command": "myDevTools.renameToKebabCase",
                        "group": "rename"
                    },
                    {
                        "command": "myDevTools.autoRename",
                        "group": "rename"
                    }
                ]
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    "ai-commands.json",
                    "**/.vscode/ai-commands.json"
                ],
                "url": "./schemas/ai-commands.schema.json"
            }
        ],
        "keybindings": [
            {
                "command": "myDevTools.stageActiveFile",
                "key": "ctrl+alt+s",
                "mac": "cmd+alt+s",
                "when": "isInDiffEditor"
            },
            {
                "command": "myDevTools.acceptCommitMessage",
                "key": "ctrl+enter",
                "mac": "cmd+enter",
                "when": "editorTextFocus && resourceFilename == MY_DEV_TOOLS_COMMIT_EDITMSG"
            }
        ]
    },
    "scripts": {
        "watch": "tsc -watch -p .",
        "pack": "npm run vscode:prepublish && vsce package",
        "type-check": "tsc --pretty --noEmit",
        "vscode:prepublish": "rimraf out && npm run esbuild-extension -- --minify && npm run esbuild-ts-morph -- --minify",
        "esbuild-base": "rimraf out && npm run esbuild-extension && npm run esbuild-ts-morph",
        "esbuild-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --alias:jsonc-parser=jsonc-parser/lib/esm/main.js",
        "esbuild-ts-morph": "esbuild ./src/tsMorphBundle.ts --bundle --outfile=out/ts-morph.js --format=cjs --platform=node",
        "publish": "vsce publish --allow-proposed-apis contribSourceControlInputBoxMenu",
        "test": "node ./out/test/test/runTest.js",
        "compile-tests": "tsc -p ./src/test/tsconfig.json",
        "pretest": "npm run esbuild-base && npm run compile-tests"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "@types/vscode": "^1.125.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "mocha": "^11.8.0",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "es-toolkit": "^1.50.0",
        "ignore": "^7.0.6",
        "istextorbinary": "^9.5.0",
        "jsonc-parser": "^3.3.1",
        "ts-morph": "^28.0.0"
    },
    "allowScripts": {
        "@vscode/vsce-sign@2.0.9": true,
        "esbuild@0.28.1": true,
        "keytar@7.9.0": true
    }
}
